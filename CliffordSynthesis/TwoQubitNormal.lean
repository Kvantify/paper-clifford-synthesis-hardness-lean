theorem coverage_rows : ∀ a b c d : BitVec 4,
    valid (a ++ b ++ c ++ d) = true → (a ++ b ++ c ++ d) ∈ witnesses.map Prod.fst := by
  decide +kernel

theorem coverage (p : Matrix) (h : valid p = true) : p ∈ witnesses.map Prod.fst := by
  have he : row p 3 ++ row p 2 ++ row p 1 ++ row p 0 = p := by
    change ((p.extractLsb' 12 4 ++ p.extractLsb' 8 4) ++ p.extractLsb' 4 4) ++ p.extractLsb' 0 4 = p
    rw [BitVec.extractLsb'_append_extractLsb'_eq_extractLsb' (by decide : 12 = 8 + 4)]
    rw [BitVec.extractLsb'_append_extractLsb'_eq_extractLsb' (by decide : 8 = 4 + 4)]
    exact BitVec.extractLsb'_append_extractLsb'
  have hh := coverage_rows (row p 3) (row p 2) (row p 1) (row p 0)
  rw [he] at hh
  exact hh h

theorem soundness : ∀ e ∈ witnesses, ∀ v : Bits, normalAction e.2 v = action e.1 v := by
  decide +kernel

/-- Every two-qubit binary symplectic map is a local layer, at most one CNOT,
a local layer, and at most one SWAP. -/
theorem normal_form (p : Matrix) (h : valid p = true) :
    ∃ f : Normal, ∀ v, normalAction f v = action p v := by
  obtain ⟨⟨q, f⟩, hm, he⟩ := List.mem_map.mp (coverage p h)
  change q = p at he
  subst q
  exact ⟨f, soundness _ hm⟩

end CliffordSynthesis.TwoQubit
