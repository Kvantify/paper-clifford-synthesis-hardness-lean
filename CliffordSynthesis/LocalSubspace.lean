module

public import CslibFrontier.Init
public import CliffordSynthesis.Local
public import Mathlib.Tactic

/-!
# Local Subspace

The local table for every isotropic subspace, without a supplied basis.
The finite algebra below proves the dimension bound:
two distinct nonzero orthogonal vectors span their joint orthogonal space.
-/

@[expose] public section

namespace CliffordSynthesis.Local

instance decidableExistsV (p : V → Prop) [DecidablePred p] : Decidable (∃ v, p v) :=
  decidable_of_iff (∃ a b c d : Bool, p (a, b, c, d))
    ⟨fun ⟨a, b, c, d, h⟩ => ⟨(a, b, c, d), h⟩,
     fun ⟨(a, b, c, d), h⟩ => ⟨a, b, c, d, h⟩⟩

private theorem beq_sound : ∀ a b : V, (a == b) = true → a = b := by decide
private theorem beq_complete : ∀ a b : V, a = b → (a == b) = true := by decide
private theorem split_or (a b : Bool) : (a || b) = true → a = true ∨ b = true := by
  cases a <;> cases b <;> decide
private theorem bool_ext (a b : Bool) (h : a = true ↔ b = true) : a = b := by
  cases a <;> cases b
  · rfl
  · exact False.elim (Bool.noConfusion (h.mpr rfl))
  · exact False.elim (Bool.noConfusion (h.mp rfl))
  · rfl

-- Kernel evaluation of the finite table needs extra recursion depth.
set_option maxRecDepth 100000 in
/-- A pair of independent isotropic vectors in F₂⁴ is maximal isotropic. -/
theorem orthogonalPairSpans : ∀ a b q : V,
    a ≠ 0 → b ≠ 0 → a ≠ b → sp a b = false →
    sp a q = false → sp b q = false → inSpan a b q = true := by decide

/-- An actual subspace of F₂⁴, specified by its membership test. -/
structure IsotropicSubspace where
  mem : V → Bool
  zero_mem : mem 0 = true
  add_mem : ∀ a b, mem a = true → mem b = true → mem (add a b) = true
  isotropic : ∀ a b, mem a = true → mem b = true → sp a b = false

private theorem span_mem (w : IsotropicSubspace) {a b q : V}
    (ha : w.mem a = true) (hb : w.mem b = true)
    (hq : inSpan a b q = true) : w.mem q = true := by
  rcases split_or _ _ hq with h | h
  · rcases split_or _ _ h with h | h
    · rcases split_or _ _ h with h | h
      · rw [beq_sound _ _ h]; exact w.zero_mem
      · rw [beq_sound _ _ h]; exact ha
    · rw [beq_sound _ _ h]; exact hb
  · rw [beq_sound _ _ h]; exact w.add_mem a b ha hb

private theorem span_zero : ∀ a b : V, inSpan a b 0 = true := by decide
private theorem span_left : ∀ a b : V, inSpan a b a = true := by decide
private theorem span_right : ∀ a b : V, inSpan a b b = true := by decide

/-- Every isotropic subspace is generated by at most two vectors.
Zero and one-dimensional spaces are included via dependent generators. -/
theorem exists_generators (w : IsotropicSubspace) :
    ∃ a b : V, sp a b = false ∧ ∀ q, w.mem q = inSpan a b q := by
  by_cases ha : ∃ a : V, w.mem a = true ∧ a ≠ 0
  · obtain ⟨a, ha, ha0⟩ := ha
    by_cases hb : ∃ b : V, w.mem b = true ∧ b ≠ 0 ∧ b ≠ a
    · obtain ⟨b, hb, hb0, hba⟩ := hb
      refine ⟨a, b, w.isotropic a b ha hb, ?_⟩
      intro q
      apply bool_ext
      exact ⟨fun hq => orthogonalPairSpans a b q ha0 hb0 (Ne.symm hba)
        (w.isotropic a b ha hb) (w.isotropic a q ha hq) (w.isotropic b q hb hq),
        span_mem w ha hb⟩
    · refine ⟨a, 0, w.isotropic a 0 ha w.zero_mem, ?_⟩
      intro q
      apply bool_ext
      constructor
      · intro hq
        by_cases hq0 : q = 0
        · rw [hq0]; exact span_zero a 0
        · by_cases hqa : q = a
          · rw [hqa]; exact span_left a 0
          · exact False.elim (hb ⟨q, hq, hq0, hqa⟩)
      · exact span_mem w ha w.zero_mem
  · refine ⟨0, 0, w.isotropic 0 0 w.zero_mem w.zero_mem, ?_⟩
    intro q
    apply bool_ext
    constructor
    · intro hq
      by_cases hq0 : q = 0
      · rw [hq0]; exact span_zero 0 0
      · exact False.elim (ha ⟨q, hq, hq0⟩)
    · exact span_mem w w.zero_mem w.zero_mem

/-- The membership-based observation does not presuppose a generating pair. -/
def IsotropicSubspace.before (w : IsotropicSubspace) : Option V × Option V :=
  ([1, 4, 5].find? w.mem, [2, 8, 10].find? w.mem)

def IsotropicSubspace.after (w : IsotropicSubspace) : Option V × Option V :=
  ([1, 12, 13].find? w.mem, [3, 8, 11].find? w.mem)

def IsotropicSubspace.signature (w : IsotropicSubspace) : Nat × Nat × Nat :=
  (present w.before.1 + present w.before.2, present w.after.1 + present w.after.2,
    birth w.before.1 w.after.1 + birth w.before.2 w.after.2)

private theorem find_congr (f g : V → Bool) (h : ∀ q, f q = g q)
    (qs : List V) : qs.find? f = qs.find? g := by
  induction qs with
  | nil => rfl
  | cons q qs ih =>
    simp only [List.find?_cons, h q, ih]

private theorem observations (w : IsotropicSubspace) (a b : V)
    (h : ∀ q, w.mem q = inSpan a b q) :
    w.before = before a b ∧ w.after = after a b := by
  constructor
  · exact congrArg₂ Prod.mk (find_congr _ _ h _) (find_congr _ _ h _)
  · exact congrArg₂ Prod.mk (find_congr _ _ h _) (find_congr _ _ h _)

/-- The effect-of-one-CNOT lemma for every local isotropic subspace. -/
theorem subspace_localTable (w : IsotropicSubspace) :
    permitted w.signature = true := by
  obtain ⟨a, b, hab, heq⟩ := exists_generators w
  obtain ⟨hbefore, hafter⟩ := observations w a b heq
  change permitted (present w.before.1 + present w.before.2,
    present w.after.1 + present w.after.2,
    birth w.before.1 w.after.1 + birth w.before.2 w.after.2) = true
  rw [hbefore, hafter]
  exact localTable a b hab

theorem subspace_rowAddition (w : IsotropicSubspace)
    (hs : w.signature = (2, 2, 1)) : rowAddition w.before w.after = true := by
  obtain ⟨a, b, hab, heq⟩ := exists_generators w
  obtain ⟨hbefore, hafter⟩ := observations w a b heq
  change (present w.before.1 + present w.before.2,
    present w.after.1 + present w.after.2,
    birth w.before.1 w.after.1 + birth w.before.2 w.after.2) = (2, 2, 1) at hs
  rw [hbefore, hafter] at hs ⊢
  exact localRowAddition a b hab hs

end CliffordSynthesis.Local
