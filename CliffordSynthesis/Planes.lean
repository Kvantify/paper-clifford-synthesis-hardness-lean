module

public import CslibFrontier.Init
public import CliffordSynthesis.Splitting
public import Mathlib.Data.ZMod.Basic
public import Mathlib.Algebra.CharP.Two
public import Mathlib.Tactic

/-!
# Planes

Actual qubit planes in an arbitrary-dimensional binary symplectic space.
In particular, visibility is an intersection, never a projection.
-/

@[expose] public section

namespace CliffordSynthesis.Planes

open LinearMap (BilinForm)

abbrev F := ZMod 2
variable {V : Type*} [AddCommGroup V] [Module F V]

def plane (a b : V) : Submodule F V := Submodule.span F {a, b}

/-- Intrinsic symplectic-basis conditions for a two-dimensional qubit plane. -/
structure SymplecticPair (B : BilinForm F V) (a b : V) : Prop where
  aa : B a a = 0
  ab : B a b = 1
  ba : B b a = 1
  bb : B b b = 0

/-- Over F₂, these are all four elements of the span, without a dimension
or independence assumption on the generators. -/
theorem mem_plane_iff (a b u : V) :
    u ∈ plane a b ↔ u = 0 ∨ u = a ∨ u = b ∨ u = a + b := by
  constructor
  · intro hu
    obtain ⟨x, y, h⟩ := Submodule.mem_span_pair.mp hu
    have h01 : ∀ z : F, z = 0 ∨ z = 1 := by decide
    rcases h01 x with rfl | rfl <;> rcases h01 y with rfl | rfl <;> simp_all
  · rintro (rfl | rfl | rfl | rfl)
    · exact Submodule.zero_mem _
    · exact Submodule.subset_span (by simp)
    · exact Submodule.subset_span (by simp)
    · exact Submodule.add_mem _ (Submodule.subset_span (by simp))
        (Submodule.subset_span (by simp))

/-- Distinct nonzero vectors in a binary symplectic plane cannot be orthogonal. -/
theorem orthogonal_unique (B : BilinForm F V) (a b : V) (hp : SymplecticPair B a b)
    {u v : V} (hu : u ∈ plane a b) (hv : v ∈ plane a b)
    (hu0 : u ≠ 0) (hv0 : v ≠ 0) (huv : B u v = 0) : u = v := by
  rcases (mem_plane_iff a b u).mp hu with hu' | hu' | hu' | hu' <;>
    rcases (mem_plane_iff a b v).mp hv with hv' | hv' | hv' | hv' <;>
    simp_all [map_add, hp.aa, hp.ab, hp.ba, hp.bb]

/-- Any two nonzero visible vectors on the same qubit are equal. -/
theorem visible_unique (B : BilinForm F V) (W : Submodule F V)
    (hW : Splitting.Isotropic B W) (a b : V) (hp : SymplecticPair B a b)
    {u v : V} (hu : u ∈ W ⊓ plane a b) (hv : v ∈ W ⊓ plane a b)
    (hu0 : u ≠ 0) (hv0 : v ≠ 0) : u = v :=
  orthogonal_unique B a b hp hu.2 hv.2 hu0 hv0 (hW hv.1 u hu.1)

theorem orthogonal_line (B : BilinForm F V) (a b : V) (hp : SymplecticPair B a b)
    {u v : V} (hu : u ∈ plane a b) (hv : v ∈ plane a b) (hu0 : u ≠ 0)
    (huv : B u v = 0) : v ∈ Submodule.span F {u} := by
  by_cases hv0 : v = 0
  · simp [hv0]
  · rw [← orthogonal_unique B a b hp hu hv hu0 hv0 huv]
    exact Submodule.subset_span (by simp)

/-- A visible intersection is exactly the line generated by its visible vector. -/
theorem visible_line (B : BilinForm F V) (W : Submodule F V)
    (hW : Splitting.Isotropic B W) (a b : V) (hp : SymplecticPair B a b)
    {u : V} (hu : u ∈ W ⊓ plane a b) (hu0 : u ≠ 0) :
    W ⊓ plane a b = Submodule.span F {u} := by
  apply le_antisymm
  · intro v hv
    by_cases hv0 : v = 0
    · simp [hv0]
    · rw [visible_unique B W hW a b hp hv hu hv0 hu0]
      exact Submodule.subset_span (by simp)
  · exact Submodule.span_le.mpr (by simpa using hu)

/-- H only changes the basis of the qubit plane. -/
theorem hadamard_plane (a b : V) : plane b a = plane a b := by
  simp [plane, Set.pair_comm]

/-- S only changes the basis of the qubit plane. -/
theorem phase_plane (a b : V) : plane a (b + a) = plane a b := by
  ext u
  rw [mem_plane_iff, mem_plane_iff]
  have haa : a + a = 0 := by
    have h : (2 : F) • a = 0 := by rw [show (2 : F) = 0 by decide, zero_smul]
    simpa [two_smul] using h
  have hab : a + (b + a) = b := by rw [add_left_comm, haa, add_zero]
  rw [hab, add_comm b a]
  tauto

/-- Free local gates preserve the intersection defining visibility. -/
theorem local_visibility (W : Submodule F V) (a b : V) :
    W ⊓ plane b a = W ⊓ plane a b ∧
    W ⊓ plane a (b + a) = W ⊓ plane a b := by
  rw [hadamard_plane, phase_plane]
  exact ⟨rfl, rfl⟩

/-- The two returned vectors of an untouched pair cannot both be globally
fresh: after excluding 0 and the two earlier generators, only their sum remains. -/
theorem no_two_fresh (a b p q : V) (hp : p ∈ plane a b) (hq : q ∈ plane a b)
    (hp0 : p ≠ 0) (hq0 : q ≠ 0) (hpa : p ≠ a) (hpb : p ≠ b)
    (hqa : q ≠ a) (hqb : q ≠ b) : p = q := by
  rcases (mem_plane_iff a b p).mp hp with hp' | hp' | hp' | hp' <;>
    rcases (mem_plane_iff a b q).mp hq with hq' | hq' | hq' | hq' <;> simp_all

end CliffordSynthesis.Planes
