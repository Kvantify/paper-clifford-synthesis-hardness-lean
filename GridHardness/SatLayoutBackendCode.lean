module

public import CslibFrontier.Init
public import GridHardness.SatCompleteTentacleCode
public import GridHardness.SatCompleteGridCorrectness
public import GridHardness.FiniteRecordLists

/-!
# SAT Layout Backend Code

Assemble the entire SAT layout from explicit cluster frames and route
records. Every complete edge tentacle is generated by the executable backend;
three-by-three cluster rectangles and all tentacles are concatenated directly.
The source-dependent record lists remain semantic inputs to this program.
-/

@[expose] public section

namespace GridHardness.SatLayoutBackendCode
open CliffordSynthesis OrthogonalTentacle SignedTentacle
open CliffordComplexity GridProblems GridProblems.GridCode GridPointCode
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency true
-- The proof unfolds nested program combinators to identify the emitted records.
set_option maxHeartbeats 1600000

abbrev InputTy := Ty.pair (.list FrameTy) (.list SatCompleteTentacleCode.InputTy)

def cluster : Code FrameTy RectangleTy :=
  .pair .id (.const (.pair PaddingTy PaddingTy)
    (List.replicate 3 false,List.replicate 3 false))

theorem cluster_eval (f : Frame) :
    cluster.eval (encodeFrame f)=GridAssembly.Rectangles.box f 3 3 := rfl

def code : Code InputTy GridPointCode.InputTy :=
  Code.append (.comp .fst (.listMap cluster))
    (.comp (.comp .snd (.listMap SatCompleteTentacleCode.code)) .listJoin)

private theorem points_mem (rs : GridPointCode.InputTy.denote) (p : Point) :
    p∈GridPointCode.points rs ↔ ∃ r∈rs,p∈rectanglePoints r := by
  simp only [GridPointCode.points,Finset.mem_biUnion,List.mem_toFinset]

private theorem mapped_lists_mem {α β : Type*} (fs : List α) (es : List β)
    (f : α →RectangleTy.denote) (g : β →GridPointCode.InputTy.denote) (p : Point) :
    p∈GridPointCode.points (fs.map f ++ (es.map g).flatten) ↔
      (∃ a∈fs,p∈rectanglePoints (f a)) ∨
      (∃ b∈es,p∈GridPointCode.points (g b)) := by
  rw [GridAssembly.Rectangles.points_append,Finset.mem_union,points_mem,points_mem]
  simp only [List.mem_map,List.mem_flatten]
  constructor
  · rintro (⟨r,⟨a,ha,rfl⟩,hp⟩|⟨r,⟨rs,⟨b,hb,rfl⟩,hr⟩,hp⟩)
    · exact Or.inl ⟨a,ha,hp⟩
    · exact Or.inr ⟨b,hb,(points_mem _ _).mpr ⟨r,hr,hp⟩⟩
  · rintro (⟨a,ha,hp⟩|⟨b,hb,hp⟩)
    · exact Or.inl ⟨_,⟨a,ha,rfl⟩,hp⟩
    · obtain ⟨r,hr,hp⟩ := (points_mem _ _).mp hp
      exact Or.inr ⟨r,⟨_,⟨b,hb,rfl⟩,hr⟩,hp⟩

theorem code_mem (fs : List FrameTy.denote) (es : List SatCompleteTentacleCode.InputTy.denote)
    (p : Point) :
    p∈GridPointCode.points (code.eval (fs,es)) ↔
      (∃ f∈fs,p∈rectanglePoints (cluster.eval f)) ∨
      (∃ e∈es,p∈GridPointCode.points (SatCompleteTentacleCode.code.eval e)) :=
  mapped_lists_mem fs es cluster.eval SatCompleteTentacleCode.code.eval p

private theorem records_interpretation {C : Type} [Fintype C] {σ : Ty}
    (f : C →σ.denote) (P : σ.denote →Prop) (Q : C →Prop)
    (h : ∀ c, P (f c) ↔Q c) :
    (∃ z∈FiniteRecordLists.records f,P z) ↔ ∃ c,Q c := by
  constructor
  · rintro ⟨z,hz,hp⟩
    obtain ⟨c,rfl⟩ := (FiniteRecordLists.mem f z).mp hz
    exact ⟨c,(h c).mp hp⟩
  · rintro ⟨c,hc⟩
    exact ⟨f c,(FiniteRecordLists.mem f (f c)).mpr ⟨c,rfl⟩,(h c).mpr hc⟩

noncomputable instance backendEdgeFintype (x : SatTy.denote) : Fintype (SatDockCorridors.Edge x) :=
  Fintype.ofFinite _

noncomputable def frames (x : SatTy.denote) (hw : ∀ c ∈x, c.length =3) : List FrameTy.denote :=
  FiniteRecordLists.records (fun v : SatBipartiteDrawing.Vertex x =>
    encodeFrame (SatNineClusterPlacement.frame x hw v))

noncomputable def edges (x : SatTy.denote) (hw : ∀ c ∈x, c.length =3) :
    List SatCompleteTentacleCode.InputTy.denote :=
  FiniteRecordLists.records (SatCompleteTentacleCode.input x hw)

noncomputable def input (x : SatTy.denote) (hw : ∀ c ∈x, c.length =3) : InputTy.denote :=
  (frames x hw,edges x hw)

noncomputable def rectangles (x : SatTy.denote) (hw : ∀ c ∈x, c.length =3) :
    GridPointCode.InputTy.denote := code.eval (input x hw)

/-- Whole-layout membership can be stated without star incidence slots:
one cluster for every vertex, one complete tentacle for every edge. -/
theorem layout_mem (x : SatTy.denote) (hw : ∀ c ∈x, c.length =3) (p : Point) :
    p∈(SatCompleteLayout.layout x hw).points ↔
      (∃ v,p∈SatNineClusterPlacement.points x hw v) ∨
      (∃ e,p∈(SatCompleteTentacles.drawing x hw e).points) := by
  rw [GridAssembly.Layout.mem_points]
  change (∃ v,p∈(SatCompleteLayout.body x hw v).points) ↔ _
  simp_rw [SatCompleteLayout.body_points,SatCompleteRegions.mem_region]
  constructor
  · rintro ⟨v,hp|⟨e,_,hp⟩⟩
    · exact Or.inl ⟨v,hp⟩
    · exact Or.inr ⟨e,hp⟩
  · rintro (⟨v,hp⟩|⟨e,hp⟩)
    · exact ⟨v,Or.inl hp⟩
    · exact ⟨SatDockCorridors.owner x e,Or.inr ⟨e,rfl,hp⟩⟩

/-- The single executable assembly produces exactly the full proved SAT grid.
No frame, route-clearance, or slot-order premise is supplied by the caller. -/
theorem points (x : SatTy.denote) (hw : ∀ c ∈x, c.length =3) :
    GridPointCode.points (rectangles x hw)=(SatCompleteLayout.layout x hw).points := by
  ext p
  change p∈GridPointCode.points (code.eval (frames x hw,edges x hw)) ↔ _
  rw [code_mem,layout_mem]
  apply or_congr
  · apply records_interpretation
    intro v
    rw [cluster_eval,GridAssembly.Rectangles.box_cluster]
    rfl
  · apply records_interpretation
    intro e
    change p∈GridPointCode.points (SatCompleteTentacleCode.rectangles x hw e) ↔ _
    rw [SatCompleteTentacleCode.points]

end GridHardness.SatLayoutBackendCode
